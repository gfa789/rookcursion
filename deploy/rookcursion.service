[Unit]
Description=rookcursion private dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=rookcursion
Group=rookcursion
WorkingDirectory=/opt/rookcursion/app
EnvironmentFile=/etc/rookcursion/app.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
StateDirectory=rookcursion
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rookcursion

[Install]
WantedBy=multi-user.target
